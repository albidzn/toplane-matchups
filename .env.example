# Copy this file to .env and fill in your own values.
# .env is git-ignored and never leaves your machine — the key is only ever
# sent to Riot's API from the local server, never to the browser.

# Get a key at https://developer.riotgames.com
# A "Personal API Key" (approved app) doesn't expire; a raw dev key expires
# every 24h and you'll need to paste a new one here each day.
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Your Riot ID, as "GameName#TAG" (shown in the client under your name).
# Keep the quotes — without them, everything from "#" onward is treated as
# a comment and gets cut off.
RIOT_ID="GameName#TAG"

# Platform your account is on: euw1, eun1, na1, kr, jp1, br1, la1, la2,
# oc1, tr1, ru, me1, ph2, sg2, th2, tw2, vn2
RIOT_PLATFORM=euw1

# How many of your most recent ranked games to pull on the very first
# fetch. Later refreshes only fetch new games since the cache remembers
# what it already has.
MATCH_COUNT=50

# Set to 1 (or "invalid_key" / "not_found" to preview those error states)
# to use fixture data instead of calling the real Riot API. Handy for
# trying out the Profile tab without a key.
# RIOT_MOCK=1
