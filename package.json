{
  "name": "league-matchups",
  "private": true,
  "version": "1.13.2",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "desktop": "vite build && electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "vite build && node scripts/make-icon.mjs && electron-builder --win --x64",
    "dist:publish": "vite build && node scripts/make-icon.mjs && electron-builder --win --x64 --publish always",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "description": "Toplane matchup guide & League profile dashboard",
  "author": "Albi",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.albi.toplane-matchups",
    "productName": "Toplane Matchups",
    "copyright": "Toplane Matchups",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "server/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/matchups.json",
        "to": "seed/matchups.json"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toplane Matchups",
      "artifactName": "Toplane-Matchups-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Toplane-Matchups-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "albidzn",
      "repo": "toplane-matchups"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/albidzn/toplane-matchups.git"
  }
}
